{
  "listen": ":7864",
  "api_key": "sk-lovart",
  "state_file": "./data/state.json",
  "upstream": {
    "www_base": "https://www.lovart.ai",
    "lgw_base": "https://lgw.lovart.ai",
    "lang": "zh"
  },
  "images": {
    "default_model": "nano-banana-pro",
    "default_edit_model": "nano-banana-pro",
    "poll_interval": "1200ms",
    "poll_max": "5s",
    "timeout": "15m",
    "download_result": false
  },
  "pool": {
    "max_concurrency_per_account": 1,
    "quota_cooldown": "6h",
    "error_cooldown": "90s",
    "max_retries": 3,
    "daily_limit": 0
  },
  "panel": {
    "auth": ""
  },
  "logging": {
    "enabled": true,
    "max_entries": 2000,
    "retention_hours": 72
  },
